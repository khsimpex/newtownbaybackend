# Supabase — same project as your Next.js frontend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxx
RAZORPAY_KEY_SECRET=your_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# CORS — your Next.js frontend origin(s), comma separated
ALLOWED_ORIGINS=http://localhost:3000,https://newtownbay.vercel.app

# Admin dashboard access is granted per user through the Supabase Auth claim
# app_metadata.role = "admin". No environment variable configures it.

# Shared secret required in the X-Internal-Secret header to call
# /internal/sweep-expired. Generate with: openssl rand -hex 32
INTERNAL_SWEEP_SECRET=your_internal_sweep_secret

# Firebase Admin service-account JSON from Railway variables; leave unset locally.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Concierge bot. The paid model path stays OFF until CONCIERGE_AI_ENABLED=true,
# so this file needs no key and deploying it costs nothing.
CONCIERGE_AI_ENABLED=false
# ANTHROPIC_API_KEY=            # required before enabling the model path
CONCIERGE_MODEL=claude-sonnet-5-5
CONCIERGE_AI_HOURLY_LIMIT_PER_CUSTOMER=10
CONCIERGE_AI_DAILY_LIMIT=300

# Minutes without an admin support message before the bot takes over answering.
ADMIN_OFFLINE_AFTER_MINUTES=15

# Server
PORT=8000
